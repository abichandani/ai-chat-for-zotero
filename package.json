{
  "name": "ai-chat-for-zotero",
  "version": "0.1.0",
  "description": "Chat with an AI assistant while reading in Zotero: explain selections, ask about the open paper, or search your library.",
  "author": "Hitesh",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abichandani/ai-chat-for-zotero.git"
  },
  "config": {
    "addonName": "AI Chat for Zotero",
    "addonID": "ai-chat@hitesh.local",
    "addonRef": "aichat",
    "addonInstance": "AIChat",
    "prefsPrefix": "extensions.aichat"
  },
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build"
  },
  "devDependencies": {
    "zotero-plugin-scaffold": "^0.8.8"
  }
}
